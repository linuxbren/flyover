# Maintainer: linuxbren <linuxbren@gmail.com>
pkgname=flyover
pkgver=0.3.0
pkgrel=1
pkgdesc="A real-time ADS-B radar scope for your terminal, built for Omarchy"
arch=('x86_64')
url="https://github.com/linuxbren/flyover"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')
# ring (a transitive dep via rustls/ureq) ships precompiled assembly object
# files for its crypto primitives. Arch's default LTO (LDFLAGS -flto=auto)
# breaks linking against them -- undefined ring_core_* symbols at link time
# -- since they aren't LTO-bitcode-compatible. Confirmed: the exact same
# `cargo build --release` succeeds outside makepkg's LTO-enabled environment.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::https://github.com/linuxbren/flyover/archive/v$pkgver.tar.gz")
sha256sums=('69e988517a546f9497ac1812057a249c5af092eb2bf8693d9e50c95efa51fa99')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  # Runtime-referenced by the optional Omarchy screensaver patches (see
  # packaging/screensaver/README.md) -- installed here so they resolve
  # without needing a git clone, but applying any of the patches is still a
  # separate, explicit opt-in step (never done automatically by this
  # package).
  install -Dm755 packaging/screensaver/patch-omarchy-screensaver.sh \
    "$pkgdir/usr/share/flyover/screensaver/patch-omarchy-screensaver.sh"
  install -Dm755 packaging/screensaver/restore-omarchy-screensaver.sh \
    "$pkgdir/usr/share/flyover/screensaver/restore-omarchy-screensaver.sh"
}
